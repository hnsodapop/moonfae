@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Thai:wght@300;400;500&family=Outfit:wght@300;400;500;600&display=swap');

.pinehome-hero-container {
  position: relative;
  width: 100%;
  max-width: 1100px;
  margin: auto;
  background: linear-gradient(rgba(43,48,39,0.75), rgba(43,48,39,0.85)), url('https://i.pinimg.com/736x/98/f3/d5/98f3d57f7314e85a3ea225512e0eef74.jpg') center/cover no-repeat;
  border-radius: 36px;
  padding: 40px 60px;
  box-shadow: 0 20px 40px rgba(0,0,0,0.3);
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.1);
  font-family: 'Outfit', 'Noto Sans Thai', sans-serif;
  color: #f4f4f0;
  box-sizing: border-box;
}

.pinehome-hero-container *,
.pinehome-hero-container *::before,
.pinehome-hero-container *::after {
  box-sizing: border-box;
  margin: 0;
  padding: 0;
}

.pinehome-hero-container .pinehome-navbar {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 50px;
}

.pinehome-hero-container .pinehome-nav-tag {
  font-size: 0.9rem;
  font-weight: 400;
  letter-spacing: 1px;
  color: #d1d5cb;
}

.pinehome-hero-container .pinehome-nav-links {
  display: flex;
  gap: 30px;
}

.pinehome-hero-container .pinehome-nav-links a {
  text-decoration: none;
  color: #d1d5cb;
  font-size: 0.85rem;
  letter-spacing: 1.5px;
  font-weight: 400;
  transition: color 0.3s ease;
}

.pinehome-hero-container .pinehome-nav-links a.pinehome-active,
.pinehome-hero-container .pinehome-nav-links a:hover {
  color: #ffffff;
  font-weight: 500;
}

.pinehome-hero-container .pinehome-content-grid {
  display: grid;
  grid-template-columns: 1.2fr 0.8fr;
  gap: 40px;
  align-items: start;
  margin-bottom: 40px;
}

.pinehome-hero-container .pinehome-hero-title {
  font-size: 3.5rem;
  font-weight: 500;
  line-height: 1.1;
  margin-bottom: 25px;
  letter-spacing: -0.5px;
}

.pinehome-hero-container .pinehome-hero-desc {
  font-family: 'Noto Sans Thai', 'Outfit', sans-serif;
  font-size: 0.95rem;
  font-weight: 300;
  line-height: 1.8;
  color: #dedede;
  max-width: 480px;
}

.pinehome-hero-container .pinehome-hero-sidebar {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  text-align: right;
  justify-content: space-between;
  height: 100%;
}

.pinehome-hero-container .pinehome-quote-text {
  font-size: 1.2rem;
  font-weight: 300;
  line-height: 1.4;
  color: #eaeaea;
  margin-bottom: 80px;
}

.pinehome-hero-container .pinehome-archive-info {
  font-size: 0.8rem;
  color: #b5beb0;
  line-height: 1.5;
}

.pinehome-hero-container .pinehome-archive-info span {
  font-weight: 500;
  color: #ffffff;
}

.pinehome-hero-container .pinehome-archive-info a {
  color: #b5beb0;
  text-decoration: none;
}

.pinehome-hero-container .pinehome-bottom-section {
  display: flex;
  justify-content: space-between;
  align-items: flex-end;
  gap: 20px;
  margin-top: 20px;
}

.pinehome-hero-container .pinehome-gallery-row {
  display: flex;
  gap: 20px;
}

.pinehome-hero-container .pinehome-gallery-img {
  width: 240px;
  height: 160px;
  border-radius: 20px;
  overflow: hidden;
  border: 1px solid rgba(255,255,255,0.15);
  box-shadow: 0 8px 20px rgba(0,0,0,0.2);
}

.pinehome-hero-container .pinehome-gallery-img img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  transition: transform 0.5s ease;
}

.pinehome-hero-container .pinehome-gallery-img img:hover {
  transform: scale(1.05);
}

.pinehome-hero-container .pinehome-social-pill {
  background: rgba(255,255,255,0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.15);
  border-radius: 30px;
  padding: 12px 10px;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.pinehome-hero-container .pinehome-social-item {
  color: #ffffff;
  font-size: 1rem;
  width: 32px;
  height: 32px;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 50%;
  cursor: default;
}

.pinehome-hero-container .pinehome-social-item img {
  width: 16px;
  height: 16px;
  object-fit: cover;
}

.pinehome-hero-container .pinehome-social-pill a.pinehome-social-item {
  text-decoration: none;
  cursor: pointer;
  transition: background 0.3s ease;
}

.pinehome-hero-container .pinehome-social-pill a.pinehome-social-item:hover {
  background: rgba(255,255,255,0.2);
}

@media (max-width: 900px) {
  .pinehome-hero-container {
    padding: 25px 20px;
  }
  .pinehome-hero-container .pinehome-content-grid {
    grid-template-columns: 1fr;
    gap: 25px;
  }
  .pinehome-hero-container .pinehome-hero-sidebar {
    align-items: flex-start;
    text-align: left;
  }
  .pinehome-hero-container .pinehome-quote-text {
    margin-bottom: 20px;
  }
  .pinehome-hero-container .pinehome-hero-title {
    font-size: 2.5rem;
  }
  .pinehome-hero-container .pinehome-bottom-section {
    flex-direction: column;
    align-items: center;
  }
  .pinehome-hero-container .pinehome-gallery-row {
    flex-direction: column;
    width: 100%;
  }
  .pinehome-hero-container .pinehome-gallery-img {
    width: 100%;
    height: 200px;
  }
  .pinehome-hero-container .pinehome-social-pill {
    flex-direction: row;
    width: 100%;
    justify-content: center;
  }
}
